<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="DAV eLibrary Automation Suite" verbose="2" parallel="false">
    <listeners>
        <listener class-name="com.elibrary.listeners.TestListener"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.elibrary.tests.api.AuthApiTests"/>
        </classes>
    </test>

    <test name="Role-Based UI Tests">
        <classes>
            <class name="com.elibrary.tests.auth.LoginTests"/>
            <class name="com.elibrary.tests.student.CatalogSearchAndFilterTests"/>
            <class name="com.elibrary.tests.teacher.ResourceUploadTests"/>
            <class name="com.elibrary.tests.admin.AdminManagementTests"/>
        </classes>
    </test>

    <test name="End-to-End Integration Tests">
        <classes>
            <class name="com.elibrary.tests.e2e.EndToEndPublishToReadTest"/>
        </classes>
    </test>
</suite>